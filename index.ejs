<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Antrean Photobooth</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 min-h-screen text-white flex flex-col justify-center items-center p-6">
    <div class="max-w-xl w-full text-center space-y-8">
        <div>
            <h1 class="text-4xl font-extrabold tracking-wide text-blue-400 mb-2">PHOTOBOOTH SYSTEM</h1>
            <p class="text-slate-400">Pilih menu navigasi di bawah ini untuk mengakses sistem antrean.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <!-- Tombol ke Halaman Order -->
            <a href="/order" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold p-6 rounded-2xl shadow-lg transition flex flex-col items-center justify-center space-y-2 border border-blue-400/30">
                <span class="text-3xl">📸</span>
                <span class="text-lg">Pelanggan</span>
                <span class="text-xs text-blue-200">Pilih Paket & QRIS</span>
            </a>

            <!-- Tombol ke Halaman Display -->
            <a href="/display" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold p-6 rounded-2xl shadow-lg transition flex flex-col items-center justify-center space-y-2 border border-amber-400/30">
                <span class="text-3xl">📺</span>
                <span class="text-lg">Layar Display</span>
                <span class="text-xs text-amber-200">Monitor TV Studio</span>
            </a>

            <!-- Tombol ke Halaman Login -->
            <a href="/login" class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold p-6 rounded-2xl shadow-lg transition flex flex-col items-center justify-center space-y-2 border border-emerald-400/30">
                <span class="text-3xl">🔑</span>
                <span class="text-lg">Kasir / Admin</span>
                <span class="text-xs text-emerald-200">Login Dashboard</span>
            </a>
        </div>

        <p class="text-xs text-slate-500 border-t border-slate-800 pt-6">
            Sistem Antrean Real-Time &bull; Express & Socket.io
        </p>
    </div>
</body>
</html>